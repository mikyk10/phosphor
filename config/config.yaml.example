port: 8082
log_level: DEBUG

# Optional shared-token protection for /pipeline routes.
# Unset (the default) leaves the endpoints open; /health is never protected.
# auth:
#   token: "${PHOSPHOR_TOKEN}"

database:
  dsn: ":memory:"           # default: in-memory (stateless)
  # dsn: ./phosphor.db       # debug: persistent file
  max_history: 200          # keep the newest N executions (-1 disables pruning)
  store_image_outputs: false # persist generated image blobs (grows the DB fast)

ai:
  request_timeout_sec: 120
  max_retries: 3
  providers:
    openai:
      endpoint: https://api.openai.com/v1
      api_key: "${OPENAI_API_KEY}"
    # ollama:
    #   endpoint: http://localhost:11434/v1
